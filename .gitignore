# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/desktop/node_modules/
/desktop/release/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
/outputs/
/work/

# rust
/target
**/*.rs.bk
Cargo.lock.orig

# Signing material. The config and update signing keys live in KMS/HSM — a leaked
# key lets an attacker redirect user traffic or ship code as LocalSystem, so these
# must never be committed even temporarily.
*.pem
*.pfx
*.p12
*.key
secrets/
